<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>eu.happycoders</groupId>
  <artifactId>java-json-api</artifactId>
  <version>1.0-SNAPSHOT</version>

  <!-- Only the comparison programs (src/main/java/comparison) need these
       libraries; the JDK examples run with the source launcher alone. -->

  <properties>
    <maven.compiler.release>28</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Plugin versions -->
    <spotless.version>3.11.0</spotless.version>

    <!-- SonarQube Cloud setup -->
    <sonar.projectKey>SvenWoltmann_java-json-api</sonar.projectKey>
    <sonar.organization>svenwoltmann</sonar.organization>
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <!-- The programs are the examples of the article; there is nothing to unit-test in them. -->
    <sonar.coverage.exclusions>**/*.java</sonar.coverage.exclusions>

    <sonar.issue.ignore.multicriteria>e1,e2</sonar.issue.ignore.multicriteria>
    <!-- ParseErrors passes its single-line documents as text blocks on purpose: the article
         quotes the listing, and text blocks show the JSON without escaped quotes. -->
    <sonar.issue.ignore.multicriteria.e1.ruleKey>java:S5663</sonar.issue.ignore.multicriteria.e1.ruleKey>
    <sonar.issue.ignore.multicriteria.e1.resourceKey>**/ParseErrors.java</sonar.issue.ignore.multicriteria.e1.resourceKey>
    <!-- EdgeCases reads "version" once per library on purpose: the article quotes the listing,
         and each line shows the complete call of one library. -->
    <sonar.issue.ignore.multicriteria.e2.ruleKey>java:S1192</sonar.issue.ignore.multicriteria.e2.ruleKey>
    <sonar.issue.ignore.multicriteria.e2.resourceKey>**/EdgeCases.java</sonar.issue.ignore.multicriteria.e2.resourceKey>
  </properties>

  <dependencies>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>3.3.0</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.15.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs>
            <arg>--add-modules</arg>
            <arg>jdk.incubator.json</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- Spotless plugin to verify code style. Unlike the other article
           repositories without google-java-format: the listings are wrapped
           for the code column of the article, and text blocks start on the
           line of the method call; google-java-format would rewrap both. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <removeUnusedImports>
              <engine>google-java-format</engine>
            </removeUnusedImports>
            <trimTrailingWhitespace/>
            <endWithNewline/>
            <indent>
              <spaces>true</spaces>
              <spacesPerTab>2</spacesPerTab>
            </indent>
            <lineEndings>UNIX</lineEndings>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
